{
  // Cloudflare Workers の設定。静的なページ（build.py が site/ に出力）と、問い合わせフォームの送信（src/index.js）。
  "name": "pokertabi",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // Cloudflare の画面で設定した変数（TO_ADDRESS など）を、デプロイで消さない
  "keep_vars": true,
  "send_email": [{ "name": "MAILER" }],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
